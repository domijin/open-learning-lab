{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Learning Lab Handoff Request v0.1",
  "type": "object",
  "required": [
    "contract_version",
    "handoff_id",
    "context_ref",
    "created_at",
    "purpose",
    "recipient_role",
    "objective",
    "required_context",
    "constraints",
    "completion"
  ],
  "properties": {
    "contract_version": {
      "const": "oll.orchestration/v0.1"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^OH-[A-Za-z0-9._-]+$"
    },
    "context_ref": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "recipient_role": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "required_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "expected_outputs",
        "on_failure"
      ],
      "properties": {
        "expected_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "on_failure": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
