{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Learning Lab Orchestration Context v0.1",
  "type": "object",
  "required": [
    "contract_version",
    "context_id",
    "created_at",
    "timeline",
    "situation",
    "state_refs",
    "policy",
    "provenance"
  ],
  "properties": {
    "contract_version": {
      "const": "oll.orchestration/v0.1"
    },
    "context_id": {
      "type": "string",
      "pattern": "^OC-[A-Za-z0-9._-]+$"
    },
    "created_at": {
      "type": "string"
    },
    "timeline": {
      "enum": [
        "learning",
        "lab-development"
      ]
    },
    "situation": {
      "type": "object",
      "additionalProperties": true
    },
    "state_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "revision"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "semantic_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target",
                "relation"
              ],
              "properties": {
                "target": {
                  "type": "string"
                },
                "relation": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "domain_as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_interval": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "thread_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback_description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "publication_scope"
      ],
      "properties": {
        "publication_scope": {
          "type": "string"
        },
        "policy_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "repository_context"
      ],
      "properties": {
        "repository_context": {
          "type": "object",
          "required": [
            "repository",
            "base_commit"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "base_commit": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "compiled_by": {
          "type": "object",
          "additionalProperties": true
        },
        "parent_context": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_handoff": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "blob_sha": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
