{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning Goal",
  "type": "object",
  "required": [
    "id",
    "status",
    "capability",
    "success_evidence",
    "created_at"
  ],
  "properties": {
    "id": {
      "pattern": "^G[0-9]{3,}$"
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "completed",
        "superseded"
      ]
    },
    "capability": {
      "type": "string"
    },
    "success_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
